# Kopiere diese Datei nach .env und trag echte Werte ein.
# .env gehoert NICHT ins Repository — sie steht in .gitignore.

# Passwort fuers Cockpit unter /admin/. Ohne diesen Wert ist das Cockpit
# geschlossen statt offen — lieber unbenutzbar als ungeschuetzt oeffentlich.
ADMIN_PASSWORT=

# Optional: ein zweites Passwort fuer die REDAKTION (z. B. die Pressewartin). Wer
# sich damit anmeldet, sieht im Cockpit nur Redaktion, Beitraege und Medien — keine
# Startseite, keine Fakten, keine Navigation. Leer = es gibt nur den Administrator.
# REDAKTION_PASSWORD=

# Signiert die Sitzungs-Cookies. Irgendeine lange Zufallszeichenkette.
# Fehlt sie, wird bei jedem Neustart eine neue erzeugt und alle werden abgemeldet.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_GEHEIMNIS=

# Leer lassen = Weg A (SQLite, data/site.db).
# Gesetzt = Postgres. src/db.js schaltet von allein um.
# DATABASE_URL=postgres://user:passwort@host:5432/datenbank

# Der Assistent (Stufe 7). Ohne diesen Schluessel bleibt das Chatfenster
# verborgen — die Website funktioniert vollstaendig weiter (P6).
# Schluessel anlegen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Welches Modell der Assistent benutzt. Vorgabe: claude-sonnet-5
# Staerker und teurer: claude-opus-5 · guenstiger: claude-haiku-4-5
# CHAT_MODELL=claude-sonnet-5

# Zugangsschutz fuer die GANZE Website: Name und Passwort, bevor etwas zu sehen
# ist. Beide setzen = Schutz an, eines leer = aus. Zum Livegang beide loeschen.
# Das ist NICHT das Cockpit-Passwort (ADMIN_PASSWORT) — wer das Cockpit
# benutzt, meldet sich nach dieser Sperre noch einmal an.
# USER_NAME=
# USER_PASSWORD=

# Vorschau: 1 = die Spieltermine der abgelaufenen Saison um Jahre nach vorn
# schieben, damit der Kalender etwas zeigt (lokal macht das 'npm run dev').
# Zum Livegang loeschen. Der Kalender sagt sichtbar, dass es Demodaten sind.
# SPIELPLAN_DEMO=1

# 1 = der Server fragt den HTV selbst nach Ergebnissen (nach 8, 16 und 24 Stunden
# und am Folgetag 14 Uhr, nur wo noch etwas fehlt). Lokal leer lassen.
# HTV_ABRUF=1

# PORT=3000
