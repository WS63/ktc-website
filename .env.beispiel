# Kopiere diese Datei nach .env und trag echte Werte ein.
# .env gehoert NICHT ins Repository — sie steht in .gitignore.

# Passwort fuers Cockpit unter /admin/. Ohne diesen Wert ist das Cockpit
# geschlossen statt offen — lieber unbenutzbar als ungeschuetzt oeffentlich.
ADMIN_PASSWORT=

# Signiert die Sitzungs-Cookies. Irgendeine lange Zufallszeichenkette.
# Fehlt sie, wird bei jedem Neustart eine neue erzeugt und alle werden abgemeldet.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_GEHEIMNIS=

# Leer lassen = Weg A (SQLite, data/site.db).
# Gesetzt = Postgres. src/db.js schaltet von allein um.
# DATABASE_URL=postgres://user:passwort@host:5432/datenbank

# Der Assistent (Stufe 7). Ohne diesen Schluessel bleibt das Chatfenster
# verborgen — die Website funktioniert vollstaendig weiter (P6).
# Schluessel anlegen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Welches Modell der Assistent benutzt. Vorgabe: claude-sonnet-5
# Staerker und teurer: claude-opus-5 · guenstiger: claude-haiku-4-5
# CHAT_MODELL=claude-sonnet-5

# PORT=3000
